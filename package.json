{
  "name": "controlador-gastos",
  "version": "0.1.0",
  "description": "Assistente pessoal de controle de gastos via Telegram",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t controlador-gastos -f docker/Dockerfile .",
    "docker:run": "docker run --rm -it --env-file .env -v $(pwd)/data:/app/data controlador-gastos"
  },
  "keywords": [
    "telegram",
    "bot",
    "finances",
    "expenses"
  ],
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.21.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  },
  "engines": {
    "node": ">=20"
  }
}
