# Token do BotFather do Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Provider de IA: 'gemini' ou 'deepseek'. Se nenhuma API key estiver setada, usa regex.
AI_PROVIDER=gemini

# API Key do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# API Key do DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# IDs de Telegram autorizados (separados por vírgula)
ALLOWED_USER_IDS=

# Caminho para os dados JSON (opcional, default: ./data)
DATA_PATH=./data

# Dia da semana para relatório semanal (0=domingo, 6=sábado)
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_TIME=10:00

# Threshold de alerta (0.0 a 1.0)
ALERT_THRESHOLD=0.8
